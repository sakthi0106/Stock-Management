# Environment Configuration Example
# Copy to .env and configure for your deployment

# Application
PROJECT_NAME="StockGuard Enterprise"
API_V1_STR="/api/v1"
DEBUG=false

# Security (Replace with strong secret: openssl rand -hex 32)
SECRET_KEY=change-this-in-production-to-a-very-long-random-secret-key-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database Connection (PostgreSQL for production; defaults to SQLite for local dev)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stock_db

# On-Premise LAN Sync Agent Pre-Shared Token
SYNC_AGENT_API_KEY=corp-sync-agent-secret-auth-token-2026

# Allowed Frontend Origins (JSON string array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage Location for Uploaded Workbooks
WORKBOOK_STORAGE_PATH="./sample-data"
