# Google Sheets Configuration
# Paste your Google Spreadsheet ID here (found in the sheet URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Absolute path to your service account JSON file OR raw JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# Background Sync Interval in seconds (default: 15s)
SYNC_INTERVAL_SECONDS=30

# Flask Server Config
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
